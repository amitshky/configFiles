gtk-color-scheme = " \
bg_color:#282828 \
fg_color:#ebdbb2 \
base_color:#1d2021 \
text_color:#ebdbb2 \
selected_bg_color:#458588 \
selected_fg_color:#ebdbb2 \
tooltip_bg_color:#3c3836 \
tooltip_fg_color:#ebdbb2 \
"

style "gruvbox-default"
{
    bg[NORMAL]      = @bg_color
    bg[PRELIGHT]    = shade(1.08, @bg_color)
    bg[ACTIVE]      = shade(0.95, @bg_color)
    bg[SELECTED]    = @selected_bg_color
    bg[INSENSITIVE] = shade(0.9, @bg_color)

    fg[NORMAL]      = @fg_color
    fg[PRELIGHT]    = @fg_color
    fg[ACTIVE]      = @fg_color
    fg[SELECTED]    = @selected_fg_color
    fg[INSENSITIVE] = shade(0.7, @fg_color)

    base[NORMAL]      = @base_color
    base[PRELIGHT]    = @base_color
    base[ACTIVE]      = @base_color
    base[SELECTED]    = @selected_bg_color
    base[INSENSITIVE] = shade(0.95, @base_color)

    text[NORMAL]      = @text_color
    text[PRELIGHT]    = @text_color
    text[ACTIVE]      = @text_color
    text[SELECTED]    = @selected_fg_color
    text[INSENSITIVE] = shade(0.7, @text_color)

    GtkWidget::focus-padding = 1
    GtkWidget::focus-line-width = 1
}

class "*" style "gruvbox-default"
