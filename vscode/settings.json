{
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "all",
    "editor.renderControlCharacters": false,
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            //"source": "PowerShell",
            "icon": "terminal-powershell",
            "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
            "args": [
                "-NoLogo",
            ]
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash"
        }
    },
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "update.enableWindowsBackgroundUpdates": false,
    "latex-workshop.view.pdf.viewer": "tab",
    "workbench.startupEditor": "none",
    "python.showStartPage": false,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "update.mode": "manual",
    "explorer.confirmDelete": false,
    "cmake.configureOnOpen": false,
    "extensions.autoUpdate": false,
    "latex-workshop.bibtex-format.tab": "tab",
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.message.error.show": false,
    "liveServer.settings.donotShowInfoMsg": true,
    "explorer.confirmDragAndDrop": false,
    "typescript.format.placeOpenBraceOnNewLineForFunctions": true,
    "javascript.format.placeOpenBraceOnNewLineForFunctions": true,
    "javascript.format.placeOpenBraceOnNewLineForControlBlocks": true,
    "typescript.format.placeOpenBraceOnNewLineForControlBlocks": true,
    "[dart]": {
        "editor.formatOnSave": false,
        "editor.formatOnType": false,
        "editor.rulers": [],
        "editor.selectionHighlight": false,
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.suggestSelection": "first",
        "editor.tabCompletion": "onlySnippets",
        "editor.wordBasedSuggestions": "off",
        "editor.tabSize": 2,
        "editor.insertSpaces": false
    },
    "dart.analyzerSshHost": null,
    "dart.runPubGetOnPubspecChanges": false,
    "python.defaultInterpreterPath": "C:\\Users\\a7shk\\AppData\\Local\\Programs\\Python\\Python310\\python.exe",
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.iconTheme": "vs-nomo-dark",
    "dart.showTodos": false,
    "explorer.sortOrder": "type",
    "editor.unicodeHighlight.allowedCharacters": {
        " ": true
    },
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.enablePersistentSessions": false,
    "liveServer.settings.CustomBrowser": "chrome",
    "comments.openView": "never",
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "[ ]",
        "[x]",
        "NOTE",
        "WARNING"
    ],
    "files.autoSave": "onWindowChange",
    //"C_Cpp.default.includePath": [
    //    "C:\\VulkanSDK\\1.3.211.0\\Include",
    //    "${workspaceFolder}/lib/**"
    //],
    "cmake.configureOnEdit": false,
    "clangd.path": "C:\\Program Files\\LLVM\\bin\\clangd.exe",
    "clangd.arguments": [
        "--log=verbose",
        "--pretty",
        "--background-index",
        "--compile-commands-dir=${workspaceFolder}",
        "--header-insertion=never",
        "-j=8"
    ],
    "editor.bracketPairColorization.enabled": false,
    "C_Cpp.default.intelliSenseMode": "clang-x64",
    "C_Cpp.default.compilerPath": "C:\\Program Files\\LLVM\\bin\\clang++.exe",
    "cmake.generator": "C:\\Program Files\\ninja\\ninja.exe",
    "C_Cpp.intelliSenseEngine": "disabled",
    "terminal.integrated.fontFamily": "'JetBrainsMonoNL Nerd Font', 'Consolas NF', 'CodeNewRoman Nerd Font Mono', Consolas",
    "editor.fontFamily": "'JetBrainsMonoNL Nerd Font', 'Consolas NF',  'CodeNewRoman Nerd Font Mono', Consolas",
    "editor.inlayHints.enabled": "off",
    "editor.tabCompletion": "on",
    "explorer.autoReveal": false,
    "todo-tree.highlights.highlightDelay": 0,
    "editor.find.autoFindInSelection": "multiline",
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "clang-format.executable": "C:\\Program Files\\LLVM\\bin\\clang-format.exe",
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "debug.onTaskErrors": "abort",
    "clang-format.fallbackStyle": "none",
    "workbench.editor.revealIfOpen": true,
    "editor.wordWrap": "on",
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "glsllint.glslangValidatorPath": "C:/VulkanSDK/1.3.243.0/Bin/glslangValidator.exe",
    "git.confirmSync": false,
    "editor.formatOnSave": false,
    "C_Cpp.clang_format_fallbackStyle": "none",
    "clang-format.language.cuda.fallbackStyle": "none",
    "clang-format.language.glsl.enable": false,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1,
        "vscodevim.vim": 1,
    },
    "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": false,
    "dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "fullSolution",
    "dotnet.codeLens.enableReferencesCodeLens": false,
    "editor.fontSize": 16,
    "terminal.integrated.fontSize": 16,
    "editor.lineNumbers": "relative",
    "vim.easymotion": false,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.timeout": 500,
    "vim.leader": "<space>",
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false,
        "<C-p>": false,
        "<C-n>": false,
        "<C-w>": false,
        "<C-j>": false,
        "<C-k>": false,
    },
    "vim.insertModeKeyBindingsNonRecursive": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        },
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "w"],
            "commands": [":w"],
            "silent": true,
        },
        {
            "before": ["<leader>", "W"],
            "commands": [":wa"],
            "silent": true,
        },
        {
            "before": ["<leader>", "c"],
            "commands": [":q"],
            "silent": true,
        },
        {
            "before": ["<leader>", "Q"],
            "commands": ["workbench.action.closeWindow"],
            "silent": true,
        },
        {
            "before": ["<leader>", "h"],
            "commands": [":nohl"],
            "silent": true,
        },
        {
            "before": ["U"],
            "after": ["<C-r>"],
            "silent": true,
        },
        {
            "before": ["<C-r>"],
            "after": ["U"],
            "silent": true,
        },
        {
            "before": ["@", "q"],
            "after": ["Q"],
            "silent": false,
        },
        {
            "before": ["<S-h>"],
            "commands": [":bprev"],
            "silent": true,
        },
        {
            "before": ["<S-L>"],
            "commands": [":bnext"],
            "silent": true,
        },
        {
            // prevents the delete operation to pollute the unnamed buffer
            "before": ["d", "d"],
            "commands": ["editor.action.deleteLines"],
            "silent": true,
        },
        {
            "before": ["<S-k>"],
            "commands": ["editor.action.showHover"],
            "silent": true,
        },
        {
            "before": ["g", "l"],
            "commands": ["editor.action.marker.nextInFiles"],
            "silent": true,
        },
        {
            "before": ["g", "L"],
            "commands": ["editor.action.marker.prevInFiles"],
            "silent": true,
        },
        {
            "before": ["g", "r"],
            "commands": ["editor.action.goToReferences"],
            "silent": true,
        },
        {
            "before": ["<leader>", "l", "r"],
            "commands": ["editor.action.rename"],
            "silent": true,
        },
        {
            "before": ["<leader>", "l", "s"],
            "commands": ["workbench.action.gotoSymbol"],
            "silent": true,
        },
        {
            "before": ["<leader>", "f", "f"],
            "commands": ["workbench.action.quickOpen"],
            "silent": true,
        },
        {
            "before": ["<leader>", "a", "h"],
            "commands": ["workbench.action.focusLeftGroup"],
            "silent": true,
        },
        {
            "before": ["<leader>", "a", "l"],
            "commands": ["workbench.action.focusRightGroup"],
            "silent": true,
        },
        {
            "before": ["<leader>", "a", "j"],
            "commands": ["workbench.action.focusBelowGroup"],
            "silent": true,
        },
        {
            "before": ["<leader>", "a", "k"],
            "commands": ["workbench.action.focusAboveGroup"],
            "silent": true,
        },
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            // prevents the delete operation to pollute the unnamed buffer
            "before": ["p"],
            "after": ["P"],
            "silent": false,
        },
    ],
    "editor.autoClosingBrackets": "never",
    "editor.autoClosingQuotes": "never",
    "editor.indentSize": "tabSize",
    "settingsSync.keybindingsPerPlatform": false,
    "lldb.suppressUpdateNotifications": true,
    "csharp.format.enable": false,
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.autoClosingDelete": "never",
    "editor.autoClosingOvertype": "never",
    "helium-icon-theme.showWelcomeMessage": false,
}